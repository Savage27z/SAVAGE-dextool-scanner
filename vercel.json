{
  "version": 2,
  "installCommand": "cd frontend && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd frontend && VITE_API_URL=${VITE_API_URL:-$FRONTEND_API_URL} VITE_WS_URL=${VITE_WS_URL:-$FRONTEND_WS_URL} VITE_TELEGRAM_BOT_NAME=${VITE_TELEGRAM_BOT_NAME:-$TELEGRAM_BOT_NAME} pnpm build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
